[package]
name = "cbor-edn"
version = "0.0.6"
edition = "2021"
# Needed to be usable with defmt; might increase when defmt does.
#
# When changing this, be sure to also change .woodpecker.yml
#
# Things to do when the MSRV is bumped are spooled by having 'feature(…)' written next to them.
rust-version = "1.76"

description = "Converter and processor for CBOR Diagnostic Notation (EDN)"
documentation = "https://docs.rs/cbor-edn"
repository = "https://codeberg.org/chrysn/cbor-edn"
license = "MIT OR Apache-2.0"
keywords = [ "cbor", "diagnostic", "edn" ]
categories = [ "parsing", "encoding", "embedded" ]

[[bin]]
name = "cbor-edn"
required-features = [ "cli" ]

[dependencies]
# all dependencies are private
data-encoding = "2.6.0"
data-encoding-macro = "0.1.15"
encoding_rs = "0.8.34" # needed to deal with the UTF-16 surrogates
hex = "0.4.3"
hexfloat2 = "0.1.3"
peg = "0.8.3"
chrono = "0.4.38"
num-bigint = "0.4.5"
num-traits = "0.2.19"

# Only for CLI tool
clap = { version = "4.5.7", features = ["derive"], optional = true }
clio = { version = "0.3.5", features = ["clap-parse"], optional = true }
eyre = { version = "0.6.12", optional = true }

[dev-dependencies]
trycmd = "0.15.4"
itertools = "0.13.0"

[features]
# Not sure what best practice is here; this at least enables `cargo install
# cbor-edn`, and allows libraries to deselect the feature (whatever
# no-default-features will mean if the library ever gains features).
default = [ "cli" ]
cli = [ "clap", "clio", "eyre" ]

[package.metadata.release]
sign-tag = true
