# Public Render backend URL (no trailing slash)
DIAGNOSTIC_BACKEND_URL=https://YOUR-BACKEND.onrender.com

# Must match the backend API_KEY used by the Render service.
DIAGNOSTIC_API_KEY=replace_me

# OpenRouter
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api
DIAGNOSTIC_LLM_PROVIDER=openrouter
DIAGNOSTIC_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Diagnostic worker budgets
DIAGNOSTIC_POLL_INTERVAL_SECS=120
DIAGNOSTIC_MAX_CONCURRENT=5
DIAGNOSTIC_DEDUP_COOLDOWN_MINUTES=20
DIAGNOSTIC_MAX_TOOL_ROUND_TRIPS=5
DIAGNOSTIC_MAX_INPUT_TOKENS=8000
DIAGNOSTIC_MAX_OUTPUT_TOKENS=1024
DIAGNOSTIC_PER_CALL_TIMEOUT_SECS=25
DIAGNOSTIC_WALL_CLOCK_BUDGET_SECS=60
DIAGNOSTIC_WATCHDOG_LOOKBACK_MINUTES=10

# MQTT credentials. The same values must be configured in Render backend
# (MQTT_USER / MQTT_PASSWORD) and on ESP32 devices.
MQTT_USER=hydragrow
MQTT_PASSWORD=replace_with_long_random_password

# InfluxDB initial admin credentials and API token.
INFLUX_INIT_USERNAME=hydragrow
INFLUX_INIT_PASSWORD=replace_with_long_random_password
INFLUX_ORG=hydragrow
INFLUX_BUCKET=sensors
INFLUX_TOKEN=replace_with_long_random_token

# Optional local-only logging.
RUST_LOG=info
