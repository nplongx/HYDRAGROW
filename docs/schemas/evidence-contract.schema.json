{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nplongx/HYDRAGROW/blob/main/docs/schemas/evidence-contract.schema.json",
  "title": "HYDRAGROW Evidence Contract",
  "type": "object",
  "required": ["requirement_id", "evidence"],
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["acceptance_id", "status", "source"],
        "properties": {
          "acceptance_id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "actual": {},
          "unit": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "environment": { "type": "string" },
          "verified_at": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
