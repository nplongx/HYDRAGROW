{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nplongx/HYDRAGROW/blob/main/docs/schemas/plan-execution-record.schema.json",
  "title": "HYDRAGROW Plan Execution Record",
  "type": "object",
  "required": ["requirement_id", "plan", "tasks", "status"],
  "properties": {
    "requirement_id": { "type": "string", "minLength": 1 },
    "plan": { "type": "string", "minLength": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^(TASK|T)-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "DONE"] },
          "evidence": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["PLANNED", "IN_PROGRESS", "BLOCKED", "VERIFIED", "ACCEPTED"] },
    "last_updated": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
