        <mxCell id="sidebar" value="HYDRAGROW\n\n▣ Tổng quan\n▤ Vận hành\n⌁ Canh tác\n≡ Nhật ký\n⚙ Cài đặt\n\n──────────\nTrạm\n[ Trạm A ▼ ]\n\nKết nối\n● Online\n\nVai trò\nOperator" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;strokeColor=#CBD5E1;fillColor=#F8FAFC;fontSize=14;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="40" y="198" width="184" height="690" as="geometry"/></mxCell>
