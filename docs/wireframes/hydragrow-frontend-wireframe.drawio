        <mxCell id="telemetry" value="TELEMETRY LIVE\nEC     1.82 mS/cm     Mục tiêu 1.8 ± 0.2\npH     6.1             Mục tiêu 6.0 ± 0.3\nTemp   24 °C           An toàn 20–28 °C\nNước   31 %            Mục tiêu 50 %\n\nCập nhật 12s trước · freshness visible" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="244" y="514" width="496" height="146" as="geometry"/></mxCell>
