        <mxCell id="pDash" value="/dashboard — Tổng quan\n\nContext header\nSystem state + risk\nQuick actions\nTelemetry group\nActive devices\nDosing summary\nE-STOP\n\nStates: loading / no stations / offline / error" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="800" y="198" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="pOps" value="/operations — Vận hành\n\nContext + mode\nActuator cards\nCommand controls\nAutomation sub-view\nCommand lifecycle:\nReady → Commanding → Confirmed / Failed / Timed out\nConfirmation dialog for consequential action" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="1160" y="198" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="pCult" value="/cultivation — Canh tác\n\nCrop / recipe\nGrowth stage\nEnvironmental targets vs actual\nActive interventions\nTabs: Seasons · Recipes · Dosing history\n\nPrioritize growing process, not raw device data" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="800" y="448" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="pJournal" value="/journal — Nhật ký\n\nTabs: Events · Analytics\nFilters / search\nEvent table\nStatus + timestamp + target\nActor when applicable\nDetail drawer\nAcknowledge where allowed\nImmutable audit trail" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="1160" y="448" width="340" height="230" as="geometry"/></mxCell>
        <mxCell id="pSettings" value="/settings — Cài đặt\n\nTabs / sections:\nGeneral · Thresholds · Connectivity · Danger Zone\n\nForm fields + units + ranges\nDesired config ≠ observed state\nExplicit Save / Apply\nValidation near source\nPermission-aware actions" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#64748B;fillColor=#FFFFFF;align=left;spacing=12;fontSize=13;fontColor=#334155" vertex="1" parent="1"><mxGeometry x="800" y="698" width="340" height="190" as="geometry"/></mxCell>
