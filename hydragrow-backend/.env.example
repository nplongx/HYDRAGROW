# Database
DATABASE_URL=postgres://user:password@localhost:5432/hydragrow

# InfluxDB (Cloud v2 API)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_influx_token_here
INFLUX_ORG=your_org
INFLUX_BUCKET=hydragrow

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=rust_backend_server
MQTT_USER=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_COMMAND_SECRET=

# Solana (leave blank to disable blockchain traceability)
SOLANA_PRIVATE_KEY=

# Logging — must point at a real Loki instance in production; the code
# falls back to http://localhost:3100 silently if unset, so logs simply
# go nowhere in a deployed environment with this unset. Confirm the real
# value is set in your Render dashboard's Environment Variables.
LOKI_URL=http://localhost:3100
ENVIRONMENT=development

# Auth
API_KEY=change_me_in_production
FIREBASE_PROJECT_ID=
ELEVATED_CONTROL_TOKEN=change_me_in_production
METRICS_TOKEN=change_me_in_production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ALLOWED_ORIGINS=
