{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-local",
  "description": "Local development-only capability template. Copy to dev.local.json for tauri dev if localhost/plaintext HTTP is required; do not ship this file in production builds.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:8000/**"
        },
        {
          "url": "http://127.0.0.1:8000/**"
        },
        {
          "url": "http://192.168.1.3:8080/**"
        }
      ]
    }
  ]
}
