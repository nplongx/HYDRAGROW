#!/usr/bin/env bash
# =============================================================================
# scripts/jules — HYDRAGROW Jules CLI
# Dispatch code-review, issue creation, audit, và hotfix tasks tới Jules.
#
# Cài đặt:
#   chmod +x scripts/jules
#   # Đảm bảo `gh` (GitHub CLI) đã authed: gh auth status
#
# Dùng:
#   ./scripts/jules review [--subsystem <name>] [--pr <number>] [--diff <file>]
#   ./scripts/jules issue  <type>  [--title "..."] [--subsystem <name>] [--body-file <file>]
#   ./scripts/jules audit  [--subsystem <name>]
#   ./scripts/jules hotfix [--subsystem <name>] [--hint "..."]
#   ./scripts/jules task   <task-file.md>
#   ./scripts/jules status [--limit <n>]
# =============================================================================
set -euo pipefail

REPO="nplongx/HYDRAGROW"
JULES_LABEL="juleson-dispatch" # Explicit label owned by repo Juleson automation
REVIEW_LABEL="review"
AUDIT_LABEL="audit"
BUG_LABEL="bug"
FEATURE_LABEL="enhancement"
HOTFIX_LABEL="hotfix"

SUBSYSTEMS=(backend shared frontend controller-core simulator firmware-controller firmware-sensor)
ISSUE_TYPES=(bug feature review audit hotfix tech-debt)

# ─── màu sắc ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()  { echo -e "${CYAN}[jules]${RESET} $*"; }
ok()    { echo -e "${GREEN}✔${RESET} $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET}  $*"; }
die()   { echo -e "${RED}✘${RESET}  $*" >&2; exit 1; }
hr()    { echo -e "${CYAN}─────────────────────────────────────────────────${RESET}"; }

# ─── guards ─────────────────────────────────────────────────────────────────
require_gh() {
  command -v gh >/dev/null 2>&1 || die "gh CLI not found. Cài: https://cli.github.com"
  gh auth status --hostname github.com >/dev/null 2>&1 \
    || die "Chưa đăng nhập gh. Chạy: gh auth login"
}

validate_subsystem() {
  local s="$1"
  [[ -z "$s" ]] && return 0   # optional
  for valid in "${SUBSYSTEMS[@]}"; do
    [[ "$s" == "$valid" ]] && return 0
  done
  die "Subsystem không hợp lệ: '$s'. Chọn một trong: ${SUBSYSTEMS[*]}"
}

# ─── helpers ────────────────────────────────────────────────────────────────
get_current_branch() { git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main"; }
get_repo_root()      { git rev-parse --show-toplevel 2>/dev/null || pwd; }

# Tạo issue và optionally assign Jules
create_issue() {
  local title="$1" body="$2" labels="$3"
  info "Tạo issue: ${BOLD}$title${RESET}"
  local url
  url=$(gh issue create \
    --repo "$REPO" \
    --title "$title" \
    --body "$body" \
    --label "$labels" \
    2>&1)
  ok "Issue tạo xong: $url"
  echo "$url"
}

# ─── COMMAND: review ────────────────────────────────────────────────────────
cmd_review() {
  local subsystem="" pr_number="" diff_file="" branch
  branch="$(get_current_branch)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subsystem|-s) subsystem="$2"; shift 2 ;;
      --pr|-p)        pr_number="$2"; shift 2 ;;
      --diff|-d)      diff_file="$2"; shift 2 ;;
      *) die "review: tham số không biết: $1" ;;
    esac
  done

  validate_subsystem "$subsystem"
  require_gh

  local diff_context=""
  if [[ -n "$diff_file" && -f "$diff_file" ]]; then
    diff_context="$(cat "$diff_file")"
  elif [[ -n "$pr_number" ]]; then
    info "Lấy diff từ PR #$pr_number ..."
    diff_context="$(gh pr diff "$pr_number" --repo "$REPO" 2>/dev/null | head -500 || true)"
  else
    info "Lấy diff từ branch hiện tại vs main ..."
    diff_context="$(git diff main...HEAD -- 2>/dev/null | head -500 || true)"
  fi

  local scope_hint=""
  [[ -n "$subsystem" ]] && scope_hint="Tập trung review subsystem: \`$subsystem\`."
  [[ -n "$pr_number" ]] && scope_hint+=" PR: #$pr_number."

  local title
  if [[ -n "$pr_number" ]]; then
    title="[Jules Review] PR #$pr_number — $(gh pr view "$pr_number" --repo "$REPO" --json title -q .title 2>/dev/null || echo "$branch")"
  else
    title="[Jules Review] Branch: $branch${subsystem:+ ($subsystem)}"
  fi

  local body
  body=$(cat <<BODY
## 🤖 Jules Code Review Task

${scope_hint}

### Mục tiêu

Jules thực hiện code review toàn diện theo các tiêu chí sau và **tạo sub-issues** cho từng phát hiện nghiêm trọng.

### Checklist review bắt buộc

**1. Module-rules compliance** (đọc \`docs/superpowers/specs/module-rules/\`)
- [ ] SQL/DB logic nằm trong \`db/\` — không viết query trong handler
- [ ] MQTT topic/payload đồng bộ với \`hydragrow-shared\`
- [ ] Không \`unwrap()\`/\`.expect()\` trên production code path
- [ ] Shared type thay đổi → cập nhật đồng thời tất cả consumer

**2. Rust quality**
\`\`\`bash
cargo fmt --all -- --check
cargo clippy --all-targets -- -D warnings
cargo test --workspace
\`\`\`

**3. Frontend quality**
\`\`\`bash
cd hydragrow-frontend && npx tsc --noEmit && npx eslint . && npx vitest run
\`\`\`

**4. Security**
- [ ] Không secret/key hardcode
- [ ] Auth middleware áp dụng đúng chỗ
- [ ] Input validation trước DB write

**5. Test coverage**
- [ ] Logic mới có unit test với explicit assertions
- [ ] Không test tautology (assert true === true)

### Diff context

\`\`\`diff
${diff_context:-(Jules sẽ tự checkout branch và lấy diff)}
\`\`\`

### Output yêu cầu

Jules tạo **comment** trên issue này với cấu trúc:

\`\`\`
## Review Summary

### 🔴 Critical (block merge)
- ...

### 🟡 Warning (should fix)
- ...

### 🟢 Suggestion (optional)
- ...

### Verification
cargo clippy exit: 0 ✓ / ✗
cargo test exit:   0 ✓ / ✗
tsc --noEmit exit: 0 ✓ / ✗
\`\`\`

Với mỗi Critical/Warning, Jules **tạo riêng 1 issue** dùng template \`jules-finding.yml\`.

---
*Dispatched bởi \`scripts/jules review\` | Branch: \`$branch\` | $(date -u +"%Y-%m-%dT%H:%M:%SZ")*
BODY
)

  create_issue "$title" "$body" "${JULES_LABEL},${REVIEW_LABEL}"
}

# ─── COMMAND: issue ──────────────────────────────────────────────────────────
cmd_issue() {
  local type="${1:-}"; shift || true
  local title="" subsystem="" body_file="" extra_body="" assignee=""

  local valid_type=0
  for t in "${ISSUE_TYPES[@]}"; do [[ "$type" == "$t" ]] && valid_type=1 && break; done
  [[ $valid_type -eq 0 ]] && die "issue type không hợp lệ: '$type'. Chọn: ${ISSUE_TYPES[*]}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title|-t)     title="$2"; shift 2 ;;
      --subsystem|-s) subsystem="$2"; shift 2 ;;
      --body-file|-f) body_file="$2"; shift 2 ;;
      --body|-b)      extra_body="$2"; shift 2 ;;
      --assign|-a)    assignee="$2"; shift 2 ;;
      *) die "issue: tham số không biết: $1" ;;
    esac
  done

  validate_subsystem "$subsystem"
  require_gh

  [[ -z "$title" ]] && {
    echo -n "Issue title: "; read -r title
  }

  local scope_tag=""
  [[ -n "$subsystem" ]] && scope_tag="[$subsystem] "

  local labels="$JULES_LABEL"
  local task_template=""

  case "$type" in
    bug)
      labels="${labels},${BUG_LABEL}"
      task_template="$(cat .agent/tasks/create-issue-bug.md 2>/dev/null || _default_bug_template "$subsystem")"
      ;;
    feature)
      labels="${labels},${FEATURE_LABEL}"
      task_template="$(cat .agent/tasks/create-issue-feature.md 2>/dev/null || _default_feature_template "$subsystem")"
      ;;
    review)
      labels="${labels},${REVIEW_LABEL}"
      task_template="$(_default_review_template "$subsystem")"
      ;;
    audit)
      labels="${labels},${AUDIT_LABEL}"
      task_template="$(_default_audit_template "$subsystem")"
      ;;
    hotfix)
      labels="${labels},${HOTFIX_LABEL},${BUG_LABEL}"
      task_template="$(_default_hotfix_template "$subsystem")"
      ;;
    tech-debt)
      labels="${labels},tech-debt"
      task_template="$(_default_techdebt_template "$subsystem")"
      ;;
  esac

  local custom_body=""
  [[ -n "$body_file" && -f "$body_file" ]] && custom_body="$(cat "$body_file")"
  [[ -n "$extra_body" ]] && custom_body="${extra_body}"

  local full_body="${task_template}"
  [[ -n "$custom_body" ]] && full_body="${full_body}

---

### Thông tin bổ sung

${custom_body}"

  local issue_url
  issue_url=$(create_issue "${scope_tag}${title}" "$full_body" "$labels")

  if [[ -n "$assignee" ]]; then
    info "Assign cho: $assignee"
    gh issue edit "$(basename "$issue_url")" --repo "$REPO" --add-assignee "$assignee" 2>/dev/null || true
  fi
}

# ─── COMMAND: audit ──────────────────────────────────────────────────────────
cmd_audit() {
  local subsystem=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subsystem|-s) subsystem="$2"; shift 2 ;;
      *) die "audit: tham số không biết: $1" ;;
    esac
  done

  validate_subsystem "$subsystem"
  require_gh

  local scope="${subsystem:-toàn bộ workspace}"
  local title="[Jules Audit] ${subsystem:-Full workspace} — $(date +%Y-%m-%d)"

  local body
  body=$(cat <<BODY
## 🔍 Jules Full Audit Task

**Phạm vi:** \`$scope\`

### Yêu cầu

Jules thực hiện audit toàn diện theo \`docs/superpowers/specs/module-rules/\` và tạo issues cho từng vi phạm.

### Audit checklist

**Structural integrity**
- [ ] Mọi MQTT topic constant đến từ \`hydragrow-shared\` (không hardcode string)
- [ ] Không SQL trong handler — chỉ trong \`db/\` module
- [ ] Shared struct thay đổi → đồng bộ tất cả consumer

**Code quality (chạy và paste output)**
\`\`\`bash
$(_audit_commands "$subsystem")
\`\`\`

**Dependency hygiene**
- [ ] Không \`unwrap()\`/\`.expect()\` trong production code path
- [ ] Không hardcode credential
- [ ] \`Cargo.lock\` commit (binary/app crate), \`.gitignore\` lock nếu là lib

**Test quality**
- [ ] Mỗi business logic function có ít nhất 1 test với assertion rõ ràng
- [ ] Không empty test body, không tautology assert

**Migration safety** (nếu backend)
- [ ] Migration mới có up + down
- [ ] Migration tested với seed data

### Output format

Jules comment trên issue với:
1. Bảng tổng hợp vi phạm (severity × file)
2. Với mỗi vi phạm Critical/High: tạo issue riêng dùng template \`jules-finding\`
3. Đề xuất thứ tự fix theo dependency

---
*Dispatched bởi \`scripts/jules audit\` | $(date -u +"%Y-%m-%dT%H:%M:%SZ")*
BODY
)

  create_issue "$title" "$body" "${JULES_LABEL},${AUDIT_LABEL}"
}

# ─── COMMAND: hotfix ─────────────────────────────────────────────────────────
cmd_hotfix() {
  local subsystem="" hint=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --subsystem|-s) subsystem="$2"; shift 2 ;;
      --hint|-h)      hint="$2"; shift 2 ;;
      *) die "hotfix: tham số không biết: $1" ;;
    esac
  done

  validate_subsystem "$subsystem"
  require_gh

  echo -n "Mô tả lỗi (ngắn gọn): "; read -r desc
  local title="[Jules Hotfix]${subsystem:+ [$subsystem]} $desc"

  local body
  body=$(cat <<BODY
## 🚨 Jules Hotfix Task

**Subsystem:** \`${subsystem:-unknown}\`
**Mô tả lỗi:** $desc
${hint:+**Gợi ý vị trí:**  $hint}

### 3-phase protocol (theo AGENTS.md §4)

**Phase 1 — Discovery (viết KHÔNG code)**
- [ ] Trace symbol liên quan đến lỗi
- [ ] Xác định root cause (paste stack trace/log nếu có)
- [ ] Liệt kê file sẽ thay đổi

**Phase 2 — Oracle & Test**
- [ ] Viết failing test reproduce lỗi
- [ ] Chạy test, xác nhận FAIL với đúng lý do
- [ ] Commit test riêng: \`test: reproduce <desc>\`

**Phase 3 — Fix & Verify**
- [ ] Implement minimal fix
- [ ] Tất cả test pass: \`$(_test_commands "$subsystem")\`
- [ ] Rebase main trước PR

### Acceptance criteria
- [ ] Root cause xác định bằng evidence
- [ ] Regression test fail trước fix, pass sau fix
- [ ] Verification commands exit 0
- [ ] PR body theo \`.github/pull_request_template.md\`

---
*Dispatched bởi \`scripts/jules hotfix\` | Branch: \`$branch\` | $(date -u +"%Y-%m-%dT%H:%M:%SZ")*
BODY
)

  create_issue "$title" "$body" "${JULES_LABEL},${HOTFIX_LABEL}"
}

# ─── COMMAND: task ───────────────────────────────────────────────────────────
cmd_task() {
  local task_file="${1:-}"
  [[ -z "$task_file" ]] && die "task: cần task-file.md"
  [[ ! -f "$task_file" ]] && die "Không tìm thấy: $task_file"
  require_gh
  info "Đọc task envelope: $task_file"
  local title
  title="[Jules Task] $(basename "$task_file" .md)"
  create_issue "$title" "$(cat "$task_file")" "$JULES_LABEL"
}

# ─── COMMAND: status ─────────────────────────────────────────────────────────
cmd_status() {
  local limit=20
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit|-n) limit="$2"; shift 2 ;;
      *) die "status: tham số không biết: $1" ;;
    esac
  done
  require_gh
  hr
  info "Issues đang chờ Jules (limit=$limit)"
  gh issue list --repo "$REPO" --label "$JULES_LABEL" --state open --limit "$limit"
  hr
  info "PRs đang mở"
  gh pr list --repo "$REPO" --state open --limit "$limit"
}

# ─── DEFAULT TEMPLATES ──────────────────────────────────────────────────────
_default_bug_template() {
  local subsystem="${1:-unknown}"
  cat <<BODY
## 🐛 Jules Bug Fix Task

**Subsystem:** \`$subsystem\`

### 3-phase protocol
1. Discovery — trace root cause, no code yet
2. Oracle/Test — write failing regression test
3. Fix — minimal implementation + full verification

### Acceptance
- Regression test proves bug before fix
- All subsystem verification commands pass
- No restricted files modified
BODY
}

_default_feature_template() {
  local subsystem="${1:-unknown}"
  cat <<BODY
## ✨ Jules Feature Task

**Subsystem:** \`$subsystem\`

### Protocol
1. Discovery — understand existing architecture
2. Test — define acceptance with tests
3. Implement — minimal change

### Acceptance
- Feature works as specified
- Tests pass
- Documentation updated if required
BODY
}

_default_review_template() {
  local subsystem="${1:-unknown}"
  cat <<BODY
## 🔍 Jules Review Task

**Subsystem:** \`$subsystem\`

Review code for correctness, security, tests, and module-rules compliance.
Create finding issues for Critical/High problems.
BODY
}

_default_audit_template() {
  local subsystem="${1:-unknown}"
  cat <<BODY
## 🔎 Jules Audit Task

**Subsystem:** \`$subsystem\`

Audit architecture, dependencies, security, tests, and module boundaries.
BODY
}

_default_hotfix_template() {
  local subsystem="${1:-unknown}"
  cat <<BODY
## 🚨 Jules Hotfix Task

**Subsystem:** \`$subsystem\`

Discovery → failing regression test → minimal fix → full verification.
BODY
}

_test_commands() {
  case "${1:-}" in
    backend) echo "cargo test --manifest-path hydragrow-backend/Cargo.toml" ;;
    shared) echo "cargo test --manifest-path hydragrow-shared/Cargo.toml" ;;
    frontend) echo "cd hydragrow-frontend && npx vitest run" ;;
    controller-core) echo "cargo test --manifest-path hydragrow-controller-core/Cargo.toml" ;;
    simulator) echo "cargo test --manifest-path hydragrow-simulator/Cargo.toml" ;;
    *) echo "bash scripts/test.sh" ;;
  esac
}

_audit_commands() {
  case "${1:-}" in
    backend) echo "cargo build --manifest-path hydragrow-backend/Cargo.toml && cargo test --manifest-path hydragrow-backend/Cargo.toml && cargo clippy --manifest-path hydragrow-backend/Cargo.toml --all-targets -- -D warnings" ;;
    frontend) echo "cd hydragrow-frontend && npm run build && npx vitest run && npx eslint . && npx tsc --noEmit" ;;
    *) echo "bash scripts/verify.sh" ;;
  esac
}

# ─── main ────────────────────────────────────────────────────────────────────
cmd="${1:-help}"; shift || true
case "$cmd" in
  review)  cmd_review "$@" ;;
  issue)   cmd_issue "$@" ;;
  audit)   cmd_audit "$@" ;;
  hotfix)  cmd_hotfix "$@" ;;
  task)   cmd_task "$@" ;;
  status) cmd_status "$@" ;;
  help|-h|--help)
    sed -n '2,18p' "$0"
    ;;
  *) die "Unknown command: $cmd. Dùng: review|issue|audit|hotfix|task|status" ;;
esac
